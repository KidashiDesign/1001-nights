---
/* ══════════════════════════════════════════════════════════════════════════
   Grundgerüst jeder Seite — Kopf, Navigation, Fuß.
   ─────────────────────────────────────────────────────────────────────────
   Die vier Sprachfassungen unterscheiden sich hier nur in Daten: lang, dir,
   Titel, hreflang und die Schriften, die vorgeladen werden. Das Layout selbst
   gibt es einmal.
   ═════════════════════════════════════════════════════════════════════════ */
import { LANGS, ui, contact, lang, pageUrl, media } from '../lib/site.js';
import Nav from '../components/Nav.astro';
import InstagramFeed from '../components/InstagramFeed.astro';
import Footer from '../components/Footer.astro';

import '../styles/fonts.css';
import '../styles/style.css';

/* Vite fasst die Schriften an und gibt die endgültigen URLs zurück — dieselben,
   die auch aus fonts.css heraus angefragt werden. */
import italianaLatin from '../assets/fonts/italiana-400-latin.woff2?url';
import cormorantLatin from '../assets/fonts/cormorant-garamond-400-latin.woff2?url';
import cormorantCyrillic from '../assets/fonts/cormorant-garamond-400-cyrillic.woff2?url';
import loraLatin from '../assets/fonts/lora-400-latin.woff2?url';
import loraCyrillic from '../assets/fonts/lora-400-cyrillic.woff2?url';
import notoGeorgian from '../assets/fonts/noto-serif-georgian-400-georgian.woff2?url';
import vazirmatn from '../assets/fonts/vazirmatn-400-arabic.woff2?url';

import type { LangCode } from '../lib/types';

interface Props { code: LangCode; page: 'home' | 'menu'; }
const { code, page } = Astro.props;

const L = lang(code);
const t = ui[code];

const title = page === 'home' ? t.meta.homeTitle : t.meta.menuTitle;
const description = page === 'home' ? t.meta.homeDesc : t.meta.menuDesc;

const canonical = new URL(pageUrl(code, page), Astro.site);
const cover = new URL(media('', '1001_Shab_Cover.webp'), Astro.site);

/* Jede Sprachfassung lädt nur die Schnitte vor, die sie wirklich braucht. */
const preloadFonts = {
  en: [italianaLatin, cormorantLatin, loraLatin],
  ru: [cormorantCyrillic, loraCyrillic],
  ka: [notoGeorgian],
  fa: [vazirmatn]
}[code];

/* Das Titelbild vorladen, damit auf dem Handy nicht die Desktop-Fassung
   gezogen wird — der Browser entscheidet anhand von imagesrcset/imagesizes. */
const hero = 'Persian_stews.webp';

const restaurantLd = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  name: '1001 Nights Restaurant',
  servesCuisine: ['Persian', 'Iranian', 'Middle Eastern'],
  priceRange: '$$',
  image: cover.href,
  url: canonical.href,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Kote Apkhazi St. 9',
    addressLocality: 'Tbilisi',
    postalCode: '0105',
    addressCountry: 'GE'
  },
  telephone: contact.phoneHref,
  email: contact.email,
  hasMenu: new URL(pageUrl(code, 'menu'), Astro.site).href,
  openingHours: ['Mo-Th 11:00-23:00', 'Fr-Sa 11:00-24:00', 'Su 11:00-23:00']
};
---
<!DOCTYPE html>
<html lang={L.htmlLang} dir={L.dir} class="no-js">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#1A1A1C" />
  <link rel="canonical" href={canonical.href} />

  {LANGS.map(o => (
    <link rel="alternate" hreflang={o.htmlLang} href={new URL(pageUrl(o.code, page), Astro.site).href} />
  ))}
  <link rel="alternate" hreflang="x-default" href={new URL(pageUrl('en', page), Astro.site).href} />

  <meta property="og:type" content={page === 'home' ? 'restaurant' : 'website'} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={cover.href} />
  <meta property="og:locale" content={L.htmlLang} />
  <meta property="og:url" content={canonical.href} />

  <link rel="icon" href={media('sm', 'Logo.webp')} type="image/webp" />

  {preloadFonts.map(href => (
    <link rel="preload" as="font" type="font/woff2" href={href} crossorigin />
  ))}

  {page === 'home' && (
    <link
      rel="preload" as="image" href={media('sm', hero)}
      imagesrcset={`${media('sm', hero)} 480w, ${media('md', hero)} 900w, ${media('', hero)} 1280w`}
      imagesizes="100vw" fetchpriority="high" />
  )}

  {page === 'home' && (
    <script type="application/ld+json" set:html={JSON.stringify(restaurantLd)} is:inline />
  )}
</head>
<body data-lightbox-close={t.lightbox.close}>
  <a class="skip-link" href="#main">{t.skipToContent}</a>

  <Nav code={code} page={page} />

  <main id="main">
    <slot />
  </main>

  <InstagramFeed code={code} />
  <Footer code={code} page={page} />

  <script>
    import '../scripts/site.js';
  </script>
</body>
</html>
