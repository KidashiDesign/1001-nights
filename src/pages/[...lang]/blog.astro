---
/* Blog — Vorschauseite. Zwei Beispielbeiträge in Karten, so wie sie später
   auch als eigene Artikel verlinkt würden. Aufbau wie about.astro: Kopf,
   dann ein Abschnitt aus dem Baukasten der Startseite. */
import { LANGS, ui, contact, media, menuUrl } from '../../lib/site.js';
import type { LangCode } from '../../lib/types';
import Base from '../../layouts/Base.astro';

export function getStaticPaths() {
  return LANGS.map(L => ({
    params: { lang: L.path ? L.path.replace(/\/$/, '') : undefined },
    props: { code: L.code as LangCode }
  }));
}

const { code } = Astro.props;
const t = ui[code];
const b = t.blogPage;

const images = ['Post1_Jashn_CharshanbeSouri.webp', 'Post2_Live_Concert.webp'];
---
<Base code={code} page="blog">

  <section class="menu-hero">
    <div class="wrap">
      <p class="menu-kicker" data-enter="fade">{b.kicker}</p>
      <h1 data-enter="up" data-delay="90">{b.title}</h1>
      <p class="lead text-muted" style="max-width:60ch" data-enter="up" data-delay="200">
        {b.lead}
      </p>
    </div>
  </section>

  <section class="section" id="blog">
    <div class="wrap">
      <div class="section-head" data-reveal="up">
        <h6>{b.sectionKicker}</h6>
        <h2>{b.sectionTitle}</h2>
      </div>

      <div class="blog-grid" data-stagger="90">
        {b.posts.map((post, i) => (
          <a class="blog-card" href="#" data-reveal="up" aria-label={post.title}>
            <div class="blog-card-media">
              <span class="tag tag-accent blog-card-badge">{post.badge}</span>
              <figure class="plate plate-3x2">
                <img
                  src={media('sm', images[i])}
                  srcset={`${media('sm', images[i])} 480w, ${media('md', images[i])} 900w`}
                  sizes="(max-width: 820px) 92vw, 480px" alt={post.title} loading="lazy" decoding="async" />
              </figure>
            </div>
            <h3 class="card-title">{post.title}</h3>
            <p class="text-muted">{post.excerpt}</p>
            <p class="blog-card-meta text-muted"><span>{b.by}</span><span>{post.author}</span></p>
            <span class="blog-card-link">{b.readMore}</span>
          </a>
        ))}
      </div>

      <p class="text-muted" style="margin-top:var(--space-8)" data-reveal="fade">{b.soon}</p>
    </div>
  </section>

  <section class="section" style="text-align:center">
    <div class="wrap wrap-narrow">
      <h2 class="display" data-reveal="up">{t.about.cta.title}</h2>
      <p class="text-muted" data-reveal="up" data-delay="80">{t.about.cta.text}</p>
      <div class="hero-actions" style="justify-content:center" data-reveal="up" data-delay="140">
        <a class="btn btn-primary" href={`tel:${contact.phoneHref}`}>{t.about.cta.ctaReserve}</a>
        <a class="btn btn-secondary" href={menuUrl(code)}>{t.about.cta.ctaMenu}</a>
      </div>
    </div>
  </section>

</Base>
