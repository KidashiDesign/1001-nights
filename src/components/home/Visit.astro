---
/* Adresse, Kontakt, Öffnungszeiten. Nummer, Adresse und Uhrzeiten stehen in
   dir="ltr"-Inseln, damit sie im persischen Satz nicht umsortiert werden. */
import { ui, contact, media, menuUrl } from '../../lib/site.js';
import Icon from '../Icon.astro';

import type { LangCode } from '../../lib/types';

interface Props { code: LangCode; }
const { code } = Astro.props;
const t = ui[code];
---
<section class="section" id="visit">
  <div class="wrap split">
    <div class="split-media" data-reveal="left" data-shrink>
      <figure class="plate plate-4x5">
        <img
          src={media('sm', 'Where_the_vibe_meets_the_flavor.webp')}
          srcset={`${media('sm', 'Where_the_vibe_meets_the_flavor.webp')} 480w, ${media('md', 'Where_the_vibe_meets_the_flavor.webp')} 900w`}
          sizes="(max-width: 820px) 92vw, 480px" alt={t.gallery.c4} loading="lazy" decoding="async" />
      </figure>
    </div>

    <div>
      <h6 data-reveal="up">{t.visit.kicker}</h6>
      <h2 data-reveal="up" data-delay="80">{t.visit.title}</h2>
      <p class="text-muted" data-reveal="up" data-delay="140">{t.visit.sub}</p>

      <div class="info-grid" style="margin-top:var(--space-8)" data-stagger="90">
        <div class="info-block" data-reveal="up">
          <h6>{t.visit.address}</h6>
          <p>{t.visit.street}<br />{t.visit.city}</p>
          <a class="link-underline" href={contact.mapUrl} target="_blank" rel="noopener">{t.visit.map} <Icon name="arrow" /></a>
        </div>
        <div class="info-block" data-reveal="up">
          <h6>{t.visit.contact}</h6>
          <p><a href={`tel:${contact.phoneHref}`} dir="ltr">{contact.phoneText}</a><br />
             <span class="text-muted">{t.visit.whatsapp}</span></p>
          <p><a href={`mailto:${contact.email}`} dir="ltr">{contact.email}</a></p>
        </div>
        <div class="info-block" data-reveal="up">
          <h6>{t.visit.hours}</h6>
          <table class="hours">
            <tbody>
              <tr><th scope="row">{t.visit.row1}</th><td dir="ltr">{contact.hours.row1}</td></tr>
              <tr><th scope="row">{t.visit.row2}</th><td dir="ltr">{contact.hours.row2}</td></tr>
              <tr><th scope="row">{t.visit.row3}</th><td dir="ltr">{contact.hours.row3}</td></tr>
            </tbody>
          </table>
        </div>
      </div>

      <div class="hero-actions" style="margin-top:var(--space-8)" data-reveal="up">
        <a class="btn btn-primary" href={`tel:${contact.phoneHref}`}>{t.visit.ctaReserve}</a>
        <a class="btn btn-secondary" href={menuUrl(code)}>{t.visit.ctaMenu}</a>
      </div>
    </div>
  </div>
</section>
