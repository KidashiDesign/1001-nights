---
/* Kopfleiste und Schublade. Beide zeigen dieselben zwei Ziele (Home, Menü) —
   die Schublade erscheint erst unter 900 px, das Stylesheet entscheidet das. */
import { ui, contact, homeUrl, menuUrl, aboutUrl, eventsUrl, coursesUrl, contactUrl, media } from '../lib/site.js'; // <-- Added "media" here
import LangSwitch from './LangSwitch.astro';

import type { LangCode } from '../lib/types';

interface Props { code: LangCode; page: 'home' | 'menu' | 'about' | 'events' | 'courses' | 'contact'; }
const { code, page } = Astro.props;

const t = ui[code];
const logo = 'logo.png'; // Add your specific logo filename here
const links = [
  { href: homeUrl(code), label: t.nav.homeLabel, current: page === 'home' },
  { href: aboutUrl(code), label: t.nav.about, current: page === 'about' },
  { href: menuUrl(code), label: t.nav.menu, current: page === 'menu' },
  { href: eventsUrl(code), label: t.nav.events, current: page === 'events' },
  { href: coursesUrl(code), label: t.nav.courses, current: page === 'courses' },
  { href: contactUrl(code), label: t.nav.contact, current: page === 'contact' }
];
---
<header class="nav">
  <div class="wrap nav-inner">
    <a class="nav-brand" href={homeUrl(code)} aria-label={t.nav.home}>
      <span class="wordmark-nav">
        <img src={media('', logo)} alt="1001 Nights" class="logo-image-nav" />
      </span>

    </a>
    <nav class="nav-links" aria-label={t.nav.main}>
      {links.map(l => (
        <a class:list={['nav-link', { 'is-current': l.current }]} href={l.href} aria-current={l.current ? 'page' : undefined}>{l.label}</a>
      ))}
    </nav>
    <div class="nav-actions">
      <LangSwitch code={code} page={page} variant="nav" />
      <a class="btn btn-primary" href={`tel:${contact.phoneHref}`}>{t.nav.reserve}</a>
      <button class="burger" type="button" aria-label={t.nav.openMenu} aria-expanded="false" aria-controls="drawer">
        <span></span>
      </button>
    </div>
  </div>
</header>

<div class="nav-drawer" id="drawer">
  <div class="wrap">
    {links.map(l => <a href={l.href}>{l.label}</a>)}
    <a class="btn btn-primary" href={`tel:${contact.phoneHref}`}>{t.nav.reserveLong}</a>
    <LangSwitch code={code} page={page} variant="drawer" />
  </div>
</div>