---
/* Fuß auf dunkler Fläche. Telefonnummer und E-Mail stehen in dir="ltr"-Inseln,
   damit sie auch im persischen Satz zum Wählen und Kopieren taugen. */
import { ui, contact, YEAR, menuUrl, aboutUrl, blogUrl, anchorUrl, fill } from '../lib/site.js';

import type { LangCode } from '../lib/types';

interface Props { code: LangCode; page: 'home' | 'menu' | 'about' | 'blog'; }
const { code, page } = Astro.props;

const t = ui[code];
/* Auf der englischen Fassung steht die Stadt englisch, sonst ohne die
   vorangestellte Straßenangabe aus `visit.city`. */
const city = code === 'en' ? 'Tbilisi' : t.visit.city.replace(/^\S+\s/, '');
---
<footer class="footer on-ink">
  <div class="wrap">
    <div class="footer-grid">
      <div class="footer-brand">
        <span class="mark">1001 Nights</span>
        <p class="text-muted">{t.footer.tagline}</p>
      </div>
      <div>
        <h6>{t.footer.pages}</h6>
        <ul>
          <li><a href={menuUrl(code)}>{t.nav.menu}</a></li>
          <li><a href={aboutUrl(code)}>{t.nav.about}</a></li>
          <li><a href={blogUrl(code)}>{t.nav.blog}</a></li>
          <li><a href={anchorUrl(code, page, '#restaurant')}>{t.nav.restaurant}</a></li>
          <li><a href={anchorUrl(code, page, '#experience')}>{t.nav.experience}</a></li>
          <li><a href={anchorUrl(code, page, '#gallery')}>{t.footer.gallery}</a></li>
        </ul>
      </div>
      <div>
        <h6>{t.footer.visit}</h6>
        <ul>
          <li><a href={anchorUrl(code, page, '#visit')}>{t.footer.hoursLink}</a></li>
          <li><a href={contact.mapUrl} target="_blank" rel="noopener">{t.footer.directions}</a></li>
          <li><a href={`tel:${contact.phoneHref}`}>{t.footer.reservation}</a></li>
        </ul>
      </div>
      <div>
        <h6>{t.footer.contact}</h6>
        <ul>
          <li><a href={`tel:${contact.phoneHref}`} dir="ltr">{contact.phoneText}</a></li>
          <li><a href={`mailto:${contact.email}`} dir="ltr">{contact.email}</a></li>
          <li>{t.visit.street}, {city}</li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <span class="text-muted">{fill(t.footer.copyright, { y: YEAR })}</span>
      <span class="text-muted">{t.footer.credit}</span>
    </div>
  </div>
</footer>
